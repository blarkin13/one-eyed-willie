<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phone app dialogs (account, sign-in, server connection, switch server):
         the app's dark sheet look instead of the default grey Android dialog. -->
    <style name="YarrSheet" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/yarr_sheet_bg</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:colorAccent">#A9DDFF</item>
        <item name="android:colorControlActivated">#A9DDFF</item>
        <item name="android:colorBackground">#111317</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C3C8CE</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFF</item>
        <item name="android:buttonBarButtonStyle">@style/YarrSheetButton</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
    <style name="YarrSheetButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#A9DDFF</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
