# Internet-facing HTTPS for the home server. Every request through here is
# marked remote (X-Yarr-Remote, overwriting anything a client sends), so the
# server requires a Yarr pass from yarr.media; the LAN is unaffected.
#
# People open app.yarr.media; the app there talks to this address directly
# (it is derived from this home's public IP), so video never goes through
# Cloudflare. The pass replaces the old setup password.
{$WILLIE_HOSTNAME} {
    reverse_proxy one-eyed-willie:8787 {
        header_up X-Yarr-Remote 1
    }
}
